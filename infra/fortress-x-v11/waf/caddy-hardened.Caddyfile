# ==============================================================================
# ASRIN KEMALİ — MKA FORTRESS X V1.1
# Sertleştirilmiş Caddy v2 Yapılandırması (HTTP/3 & Automatic Let's Encrypt TLS)
# ==============================================================================

{
    admin off
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
        client_ip_headers CF-Connecting-IP X-Forwarded-For
        protocols h1 h2 h3
        strict_sni_host insecure_off
    }
}

asrinkemali.org, www.asrinkemali.org {
    # 1. TLS Sertifikasyon ve Şifreleme Sıkılaştırma
    tls {
        protocols tls1.2 tls1.3
        ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
    }

    # 2. Güvenlik Başlıkları
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # 3. Kötü Niyetli İstek ve Hassas Yol Koruması
    @blocked_paths {
        path /.env* /.git* /wp-admin* /wp-login* /phpmyadmin* *.bak *.sql
    }
    respond @blocked_paths 404

    @invalid_methods {
        not method GET HEAD POST OPTIONS
    }
    respond @invalid_methods 405

    # 4. Statik Varlıklar Önbellekleme
    @static {
        path /_next/static/* /assets/* /favicon.ico
    }
    header @static {
        Cache-Control "public, max-age=2592000, immutable"
    }

    # 5. Sağlık Uç Noktaları
    @health {
        path /api/health /api/ready
    }
    header @health {
        Cache-Control "no-store, no-cache, must-revalidate"
    }

    # 6. Ters Vekil Aktarımı
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
}
