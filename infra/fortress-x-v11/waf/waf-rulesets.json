{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "mka-fortress-waf-rulesets",
  "version": "1.2.0",
  "description": "ASRIN KEMALİ WAF ve Hız Sınırlama Kuralları Matrisi (Sıfır-Atlatma / Zero-Skip Mimari)",
  "rulesets": [
    {
      "id": "WAF-01-SENSITIVE-FILES",
      "action": "block",
      "priority": 1,
      "phase": "http_request_firewall_custom",
      "description": "Hassas dizin (.env, .git, .bak, config) ve yönetim yolu taramalarını engelle",
      "target_patterns": ["/.env", "/.git", "/wp-admin", "/wp-login", "/phpmyadmin", "/.aws", "/.ssh", ".bak", ".sql"]
    },
    {
      "id": "WAF-02-VULN-SCANNERS",
      "action": "block",
      "priority": 2,
      "phase": "http_request_firewall_custom",
      "description": "Otomatik zafiyet tarayıcılarını ve exploit araçlarını engelle",
      "blocked_user_agents": ["sqlmap", "nikto", "nmap", "acunetix", "masscan", "zgrab", "gobuster", "dirbuster"]
    },
    {
      "id": "WAF-03-HTTP-METHODS",
      "action": "block",
      "priority": 3,
      "phase": "http_request_firewall_custom",
      "description": "Salt-okunur kamusal sitede geçersiz HTTP metotlarını engelle",
      "blocked_methods": ["TRACE", "TRACK", "CONNECT", "DELETE", "PUT"]
    },
    {
      "id": "WAF-04-EXPLOIT-PAYLOADS",
      "action": "block",
      "priority": 4,
      "phase": "http_request_firewall_custom",
      "description": "Açık XSS, SQLi, RCE ve Yol Geçişi saldırılarını /arsiv dahil tüm rotalarda engelle",
      "attack_patterns": [
        "<script",
        "javascript:",
        "onerror=",
        "onload=",
        "../",
        "..%2f",
        "union select",
        "union all select",
        "' or '1'='1",
        "'; drop table",
        "drop table",
        "waitfor delay",
        "information_schema",
        "sleep("
      ]
    },
    {
      "id": "WAF-MANAGED-CRS",
      "action": "execute",
      "priority": 5,
      "phase": "http_request_firewall_managed",
      "description": "Cloudflare Managed Ruleset (OWASP Core Ruleset) çalıştırma",
      "managed_ruleset_id": "efb7b8c94f9e413c848e4f101965f14e"
    },
    {
      "id": "RATELIMIT-01-SEARCH",
      "action": "block",
      "priority": 6,
      "phase": "http_ratelimit",
      "description": "Arşiv ve arama sorguları hız sınırlaması",
      "rate_limit": {
        "requests": 30,
        "period_seconds": 10,
        "action": "block",
        "mitigation_timeout_seconds": 60
      },
      "target_routes": ["/api/search", "/arsiv", "/arastirma"]
    },
    {
      "id": "RATELIMIT-02-GENERAL-PAGES",
      "action": "challenge",
      "priority": 7,
      "phase": "http_ratelimit",
      "description": "Genel sayfa gezinmesi agresif tarama koruması",
      "rate_limit": {
        "requests": 120,
        "period_seconds": 10,
        "action": "challenge",
        "mitigation_timeout_seconds": 120
      },
      "exempt_routes": [
        "/_next/static/*",
        "/assets/*",
        "/api/health",
        "/api/ready",
        "/favicon.ico"
      ]
    }
  ]
}
