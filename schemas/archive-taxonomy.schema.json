{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisensai/asrinkemali/schemas/archive-taxonomy.schema.json",
  "title": "Asrın Kemali Arşiv Taksonomisi",
  "description": "Arşiv kayıtlarında kullanılan tür, kategori, hak ve doğrulama sözlükleri.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "categories",
    "types",
    "rightsStatuses",
    "verificationStatuses",
    "institutionTypes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "types": {
      "type": "array",
      "minItems": 6,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "rightsStatuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "verificationStatuses": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "institutionTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/term"
      }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 60
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        }
      }
    }
  }
}
